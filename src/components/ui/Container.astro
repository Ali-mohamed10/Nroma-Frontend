---
/**
 * Container.astro
 *
 * Reusable layout wrapper providing consistent responsive max-width and horizontal padding.
 */
interface Props {
  as?: string;
  class?: string;
  className?: string;
}

const { as: Tag = 'div', class: classProp = '', className = '' } = Astro.props;
---

<Tag class:list={['w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8', classProp, className]}>
  <slot />
</Tag>
