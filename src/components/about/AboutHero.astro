<style is:global>
  /* ============================================================
     3D Interactive Magazine CSS Architecture (Desktop & Tablet)
     Pure CSS Hardware-Accelerated Flipbook
     ============================================================ */

  .book-viewport-wrapper {
    perspective: 2000px;
    padding: 1rem 0;
  }

  .book-wrapper {
    width: 100%;
    max-width: 1040px;
    height: 520px;
    position: relative;
    margin: 0 auto;
    perspective: 2000px;
  }

  /* Responsive Book Scaling for tablets */
  @media (max-width: 1100px) and (min-width: 768px) {
    .book-wrapper {
      max-width: 760px;
      height: 460px;
    }
  }

  .pages {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    box-shadow: 0 30px 60px -15px rgba(25, 20, 50, 0.16), 0 8px 24px -4px color-mix(in srgb, var(--color-primary) 12%, transparent);
    border-radius: 12px;
    transition: box-shadow 0.3s ease;
  }

  :root[data-theme="dark"] .pages {
    box-shadow: 0 35px 50px -15px rgba(0, 0, 0, 0.7), 0 0 40px color-mix(in srgb, var(--color-primary) 15%, transparent);
  }

  /* Hide radio triggers completely */
  .book-radio {
    display: none !important;
  }

  /* Base Page Styling */
  .pages_page {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.9s cubic-bezier(0.6, 0.045, 0.165, 1), z-index 0s 0.45s;
    pointer-events: none;
  }

  .pages_page__inner {
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    box-sizing: border-box;
    backface-visibility: hidden;
  }

  /* Page 1 (Base Left inside cover) */
  .pages_page.page-1 {
    left: 0;
    right: auto;
    z-index: 0;
    transform: rotateY(0deg) !important;
    pointer-events: none;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
  }
  .pages_page.page-1 .pages_page__inner {
    transform: rotateY(0deg) !important;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
  }

  /* Pages 2-8 (Right Stack that flips around spine at left edge) */
  .pages_page.page-2,
  .pages_page.page-3,
  .pages_page.page-4,
  .pages_page.page-5,
  .pages_page.page-6,
  .pages_page.page-7,
  .pages_page.page-8 {
    right: 0;
    left: auto;
    transform-origin: 0% 50%;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
  }

  /* Odd pages (3, 5, 7) backface is turned 180deg */
  .pages_page.page-3 .pages_page__inner,
  .pages_page.page-5 .pages_page__inner,
  .pages_page.page-7 .pages_page__inner {
    transform: rotateY(180deg);
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
  }

  /* Initial Z-Index Stack (Page 1 & 2 visible) */
  .pages_page.page-2 { z-index: 7; pointer-events: auto; }
  .pages_page.page-3 { z-index: 6; }
  .pages_page.page-4 { z-index: 5; }
  .pages_page.page-5 { z-index: 4; }
  .pages_page.page-6 { z-index: 3; }
  .pages_page.page-7 { z-index: 2; }
  .pages_page.page-8 { z-index: 1; border-top-right-radius: 10px; border-bottom-right-radius: 10px; }

  /* ============================================================
     FLIP STATES TRIGGERED BY RADIO INPUTS (Using Sibling combinator ~)
     ============================================================ */

  /* Trigger 2: Spread 2 (Pages 3 & 4) */
  #page-trigger-2:checked ~ .book-viewport-wrapper .page-2 {
    transform: rotateY(-180deg);
    z-index: 10;
    pointer-events: none;
  }
  #page-trigger-2:checked ~ .book-viewport-wrapper .page-3 {
    transform: rotateY(-180deg);
    z-index: 10;
    pointer-events: auto;
  }
  #page-trigger-2:checked ~ .book-viewport-wrapper .page-4 {
    z-index: 8;
    pointer-events: auto;
  }

  /* Trigger 3: Spread 3 (Pages 5 & 6) */
  #page-trigger-3:checked ~ .book-viewport-wrapper .page-2,
  #page-trigger-3:checked ~ .book-viewport-wrapper .page-3 {
    transform: rotateY(-180deg);
    z-index: 5;
    pointer-events: none;
  }
  #page-trigger-3:checked ~ .book-viewport-wrapper .page-4 {
    transform: rotateY(-180deg);
    z-index: 10;
    pointer-events: none;
  }
  #page-trigger-3:checked ~ .book-viewport-wrapper .page-5 {
    transform: rotateY(-180deg);
    z-index: 10;
    pointer-events: auto;
  }
  #page-trigger-3:checked ~ .book-viewport-wrapper .page-6 {
    z-index: 8;
    pointer-events: auto;
  }

  /* Trigger 4: Spread 4 (Pages 7 & 8) */
  #page-trigger-4:checked ~ .book-viewport-wrapper .page-2,
  #page-trigger-4:checked ~ .book-viewport-wrapper .page-3,
  #page-trigger-4:checked ~ .book-viewport-wrapper .page-4,
  #page-trigger-4:checked ~ .book-viewport-wrapper .page-5 {
    transform: rotateY(-180deg);
    z-index: 4;
    pointer-events: none;
  }
  #page-trigger-4:checked ~ .book-viewport-wrapper .page-6 {
    transform: rotateY(-180deg);
    z-index: 10;
    pointer-events: none;
  }
  #page-trigger-4:checked ~ .book-viewport-wrapper .page-7 {
    transform: rotateY(-180deg);
    z-index: 10;
    pointer-events: auto;
  }
  #page-trigger-4:checked ~ .book-viewport-wrapper .page-8 {
    z-index: 8;
    pointer-events: auto;
  }

  /* ============================================================
     CONTROLS & NAVIGATION ARROWS
     ============================================================ */

  .control {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    background-color: var(--surface-elevated);
    border: 1.5px solid var(--color-primary);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-primary) 20%, transparent);
    cursor: pointer;
    z-index: 25;
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .control svg {
    color: var(--color-primary);
    transition: color 0.25s ease;
  }

  .control:hover {
    transform: translateY(-50%) scale(1.15);
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-primary) 45%, transparent);
  }

  .control:hover svg {
    color: var(--color-white) !important;
  }

  :root[data-theme="dark"] .control {
    background-color: var(--surface-color);
    border: 1.5px solid var(--color-primary);
    box-shadow: 0 0 15px color-mix(in srgb, var(--color-primary) 25%, transparent);
  }

  :root[data-theme="dark"] .control svg {
    color: var(--color-primary);
  }

  :root[data-theme="dark"] .control:hover {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .control.next {
    right: 14px;
  }
  .control.prev {
    left: 14px;
  }

  .control label {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  /* ============================================================
     CIRCULAR PAGINATION DOTS
     ============================================================ */

  .book-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .page-dot {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--border-color);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .page-dot:hover {
    background-color: color-mix(in srgb, var(--color-primary) 50%, transparent);
    transform: scale(1.25);
  }

  :root[data-theme="dark"] .page-dot {
    background-color: rgba(255, 255, 255, 0.25);
  }

  :root[data-theme="dark"] .page-dot:hover {
    background-color: color-mix(in srgb, var(--color-primary) 70%, transparent);
  }

  /* Active Circular Dot Indicator */
  #page-trigger-1:checked ~ .book-pagination label[for="page-trigger-1"],
  #page-trigger-2:checked ~ .book-pagination label[for="page-trigger-2"],
  #page-trigger-3:checked ~ .book-pagination label[for="page-trigger-3"],
  #page-trigger-4:checked ~ .book-pagination label[for="page-trigger-4"] {
    background-color: var(--color-primary) !important;
    transform: scale(1.35);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary) 28%, transparent);
  }
</style>
