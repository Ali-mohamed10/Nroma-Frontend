---
/**
 * AboutHero.astro — Interactive 3D Agency Magazine Flipbook Section
 *
 * Implements the 3D Pure CSS interactive book flip concept:
 * - Pure CSS 3D perspective, hardware-accelerated transforms (transform-style: preserve-3d)
 * - Uses brand background pattern (`/images/hero/bg-pattern.webp`)
 * - Features Naroma's official copy, manifesto, 3 pillars, credentials, and CTAs
 * - Provides both intuitive page turn arrows and spread navigation tabs
 */
import Container from '../ui/Container.astro';
import { t } from '../../lib/i18n/index.js';

interface Props {
  locale: 'ar' | 'en';
}

const { locale } = Astro.props;
const isRtl = locale === 'ar';
---

<section class="about-book-section relative min-h-[calc(100vh-4.5rem)] sm:min-h-[calc(100vh-5rem)] flex flex-col justify-center items-center py-8 sm:py-12 md:py-16 overflow-hidden select-none bg-gradient-to-b from-background via-surface to-background text-foreground transition-colors duration-300">
  
  <!-- Creative Tiled Background Pattern Watermark (Zero-cost blending) -->
  <div
    class="pointer-events-none absolute inset-0 z-0 bg-repeat opacity-[0.03] dark:opacity-[0.05] bg-[url('/images/hero/bg-pattern.webp')] bg-[length:320px_430px]"
    aria-hidden="true"
  ></div>

  <!-- Ambient Brand Purple and Lime Glowing Lights (Hardware-efficient radial gradients, 0 blur GPU overhead) -->
  <div
    class="pointer-events-none absolute -top-32 end-0 z-0 w-[550px] h-[550px] rounded-full bg-[radial-gradient(circle,rgba(109,64,219,0.16)_0%,transparent_70%)] dark:bg-[radial-gradient(circle,rgba(109,64,219,0.22)_0%,transparent_70%)]"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-32 start-0 z-0 w-[450px] h-[450px] rounded-full bg-[radial-gradient(circle,rgba(215,255,123,0.12)_0%,transparent_70%)] dark:bg-[radial-gradient(circle,rgba(215,255,123,0.08)_0%,transparent_70%)]"
    aria-hidden="true"
  ></div>

  <Container class="relative z-10 w-full flex flex-col items-center">
    
    <!-- Editorial Eyebrow Header -->
    <div class="text-center max-w-xl mx-auto mb-6 sm:mb-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-primary  text-sm sm:text-base font-semibold mb-3 backdrop-blur-md transition-colors duration-200">
        <span>{t(locale, 'about.hero.badge')} — Editorial Edition</span>
      </div>
      <p class="text-sm sm:text-base text-muted transition-colors duration-200">
        {isRtl ? 'تصفح كتاب نروما التفاعلي واستكشف قصتنا وفلسفتنا في بناء العلامات التجارية' : 'Flip through the interactive Nroma editorial edition to explore our story and philosophy'}
      </p>
    </div>

    <!-- 3D Book Root Container with Shared Sibling Inputs (Desktop & Tablet) -->
    <div class="book-container-root hidden md:flex w-full flex-col items-center">
      <!-- 4 Radio triggers for 4 spreads -->
      <input id="page-trigger-1" name="book-trigger" type="radio" checked class="book-radio" aria-label="Spread 1" />
      <input id="page-trigger-2" name="book-trigger" type="radio" class="book-radio" aria-label="Spread 2" />
      <input id="page-trigger-3" name="book-trigger" type="radio" class="book-radio" aria-label="Spread 3" />
      <input id="page-trigger-4" name="book-trigger" type="radio" class="book-radio" aria-label="Spread 4" />

      <!-- Viewport Wrapper -->
      <div class="book-viewport-wrapper w-full flex justify-center items-center pb-2">
        <div class="book-wrapper" dir="ltr">
          <div class="pages">

            <!-- ==================== PAGE 1 (Left: Inside Cover / Vision) ==================== -->
            <div class="pages_page page-1">
              <div
                class="pages_page__inner bg-surface-elevated text-foreground border-r border-border p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden transition-colors duration-300"
                dir={isRtl ? 'rtl' : 'ltr'}
              >
                <!-- Spine shadow overlay on right edge -->
                <div class="pointer-events-none absolute top-0 right-0 bottom-0 w-8 bg-gradient-to-l from-black/40 to-transparent opacity-30 dark:opacity-100 z-20" aria-hidden="true"></div>

                <!-- Watermark pattern -->
                <div class="pointer-events-none absolute inset-0 opacity-[0.025] dark:opacity-[0.04] bg-repeat bg-[url('/images/hero/bg-pattern.webp')] bg-[length:260px_350px]"></div>
                
                <!-- Header -->
                <div class="relative z-10 flex items-center justify-between border-b border-border pb-4">
                  <div class="flex items-center gap-2">
                    <span class="font-heading font-black text-lg tracking-wider text-foreground">NROMA</span>
                    <span class="text-xs px-2 py-0.5 rounded bg-primary/15 text-primary font-semibold border border-primary/30">AGENCY</span>
                  </div>
                  <div class="text-xs font-mono font-bold text-primary tracking-widest">01 / 08</div>
                </div>

                <!-- Main Content -->
                <div class="relative z-10 my-auto py-4">
                  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-foreground leading-[1.3] mb-4">
                    <span>{t(locale, 'about.hero.titlePart1')} </span>
                    <span class="text-primary">{t(locale, 'about.hero.titleHighlight')}</span>
                  </h2>
                  <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-md">
                    {t(locale, 'about.hero.subtitle')}
                  </p>
                </div>

                <!-- Footer Statement -->
                <div class="relative z-10 border-t border-border pt-4 flex items-center justify-between text-[11px] text-muted">
                  <span>{isRtl ? 'الرؤية والتموضع الاستراتيجي' : 'Vision & Positioning'}</span>
                  <span class="font-mono text-muted">EST. 2024</span>
                </div>
              </div>
            </div>

            <!-- ==================== PAGE 2 (Right: Cover / Turn to Spread 2) ==================== -->
            <div class="pages_page page-2">
              <div
                class="pages_page__inner bg-[#0a0a0f] text-white border-l border-border relative overflow-hidden flex flex-col justify-between"
                dir={isRtl ? 'rtl' : 'ltr'}
              >
                <!-- Background Cover Image -->
                <img
                  src="/images/hero/photo-1618005182384-a83a8bd57fbe.webp"
                  alt=""
                  class="pointer-events-none select-none absolute inset-0 w-full h-full object-cover"
                  aria-hidden="true"
                />

                <!-- Ambient Contrast Overlays (Matching Hero.astro) -->
                <div class="pointer-events-none absolute inset-0 bg-[#0a0a0f]/65" aria-hidden="true"></div>
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#0a0a0f] via-[#0a0a0f]/40 to-transparent" aria-hidden="true"></div>
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#0a0a0f]/80 via-transparent to-[#0a0a0f]/40 rtl:bg-gradient-to-l" aria-hidden="true"></div>

                <!-- Header -->
                <div class="relative z-10 p-6 sm:p-8 flex items-center justify-between">
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-white/10 border border-white/15 text-white backdrop-blur-md">
                    {isRtl ? 'الغلاف الخارجي' : 'Front Cover'}
                  </span>
                  <div class="text-xs font-mono font-bold text-primary tracking-widest">02 / 08</div>
                </div>

                <!-- Content -->
                <div class="relative z-10 p-6 sm:p-8">
                 
                  <h3 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white mb-2 leading-11">
                    {t(locale, 'about.philosophy.headlinePart1')}
                    <span class="text-primary"> {t(locale, 'about.philosophy.headlineHighlight')}</span>
                  </h3>
                  <p class="text-xs text-gray-300">
                    {isRtl ? 'انقر على السهم لقلب الصفحة واستكشاف فلسفتنا' : 'Click the arrow to flip to the next spread'}
                  </p>
                </div>

                <!-- Page Turn Control (Next - Flips inward to the left) -->
                <div class="control next" title={isRtl ? 'الصفحة التالية' : 'Next Page'}>
                  <label for="page-trigger-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                  </label>
                </div>
              </div>
            </div>

            <!-- ==================== PAGE 3 (Left of Spread 2: Manifesto) ==================== -->
            <div class="pages_page page-3">
              <div
                class="pages_page__inner bg-surface-elevated text-foreground border-r border-border p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden transition-colors duration-300"
                dir={isRtl ? 'rtl' : 'ltr'}
              >
                <!-- Spine shadow overlay on right edge -->
                <div class="pointer-events-none absolute top-0 right-0 bottom-0 w-8 bg-gradient-to-l from-black/40 to-transparent opacity-30 dark:opacity-100 z-20" aria-hidden="true"></div>

                <div class="relative z-10 flex items-center justify-between border-b border-border pb-4">
                  <span class="text-xs font-bold text-primary tracking-wider uppercase">
                    {t(locale, 'about.philosophy.badge')}
                  </span>
                  <div class="text-xs font-mono font-bold text-primary tracking-widest">03 / 08</div>
                </div>

                <!-- Turn Back Control (Prev - Flips back to the right) -->
                <div class="control prev" title={isRtl ? 'الصفحة السابقة' : 'Previous Page'}>
                  <label for="page-trigger-1">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </label>
                </div>

                <div class="relative z-10 my-auto py-4">
                  
                  <h3 class="text-base sm:text-lg font-bold text-foreground mb-2 leading-snug">
                    "{t(locale, 'about.philosophy.tagline')}"
                  </h3>
                  <p class="text-xs text-muted leading-relaxed">
                    {t(locale, 'about.philosophy.p1')}
                  </p>
                </div>

                <div class="relative z-10 border-t border-border pt-3 text-[11px] text-muted">
                  <span>{isRtl ? 'الفلسفة والمبادئ' : 'Philosophy & Core Manifesto'}</span>
                </div>
              </div>
            </div>

            <!-- ==================== PAGE 4 (Right of Spread 2: Vision Quote & Next) ==================== -->
            <div class="pages_page page-4">
              <div
                class="pages_page__inner bg-surface text-foreground border-l border-border p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden transition-colors duration-300"
                dir={isRtl ? 'rtl' : 'ltr'}
              >
                <!-- Spine shadow overlay on left edge -->
                <div class="pointer-events-none absolute top-0 left-0 bottom-0 w-8 bg-gradient-to-r from-black/40 to-transparent opacity-30 dark:opacity-100 z-20" aria-hidden="true"></div>

                <div class="relative z-10 flex items-center justify-between border-b border-border pb-4">
                  <span class="text-xs font-semibold text-muted">
                    {isRtl ? 'بيان الوكالة' : 'Agency Statement'}
                  </span>
                  <div class="text-xs font-mono font-bold text-primary tracking-widest">04 / 08</div>
                </div>

                <!-- Quote Block -->
                <div class="relative z-10 my-auto py-6">
                  <div class="text-4xl font-serif text-primary opacity-80 leading-none mb-3">“</div>
                  <p class="text-sm sm:text-base lg:text-lg font-medium text-foreground leading-relaxed mb-4">
                    {t(locale, 'about.philosophy.p2')}
                  </p>
                  <div class="border-s-2 border-primary ps-3 text-xs text-primary font-semibold">
                    {isRtl ? 'وكالة نروما للتسويق وبناء العلامات التجارية' : 'Nroma Branding & Marketing Agency'}
                  </div>
                </div>

                <!-- Turn Next Control (Next - Flips inward to the left) -->
                <div class="control next" title={isRtl ? 'الصفحة التالية' : 'Next Page'}>
                  <label for="page-trigger-3">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                  </label>
                </div>

                <div class="relative z-10 border-t border-border pt-3 text-[11px] text-muted">
                  <span>{isRtl ? 'منظومة الأثر' : 'Ecosystem of Impact'}</span>
                </div>
              </div>
            </div>

            <!-- ==================== PAGE 5 (Left of Spread 3: Pillars 1 & 2) ==================== -->
            <div class="pages_page page-5">
              <div
                class="pages_page__inner bg-surface-elevated text-foreground border-r border-border p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden transition-colors duration-300"
                dir={isRtl ? 'rtl' : 'ltr'}
              >
                <!-- Spine shadow overlay on right edge -->
                <div class="pointer-events-none absolute top-0 right-0 bottom-0 w-8 bg-gradient-to-l from-black/40 to-transparent opacity-30 dark:opacity-100 z-20" aria-hidden="true"></div>

                <div class="relative z-10 flex items-center justify-between border-b border-border pb-4">
                  <span class="text-xs font-bold text-primary tracking-wider uppercase">
                    {isRtl ? 'ركائزنا الاستراتيجية' : 'Strategic Pillars'}
                  </span>
                  <div class="text-xs font-mono font-bold text-primary tracking-widest">05 / 08</div>
                </div>

                <!-- Turn Back Control (Prev - Flips back to the right) -->
                <div class="control prev" title={isRtl ? 'الصفحة السابقة' : 'Previous Page'}>
                  <label for="page-trigger-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </label>
                </div>

                <div class="relative z-10 my-auto space-y-3.5 py-2">
                  <!-- Pillar 1 -->
                  <div class="p-3 sm:p-3.5 rounded-xl bg-surface border border-border">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="w-4 h-4 rounded-full bg-primary text-white text-[10px] font-bold flex items-center justify-center">1</span>
                      <h4 class="text-xs sm:text-sm font-bold text-primary">{t(locale, 'about.philosophy.card1.title')}</h4>
                    </div>
                    <p class="text-[11px] sm:text-xs text-muted leading-relaxed">
                      {t(locale, 'about.philosophy.card1.desc')}
                    </p>
                  </div>

                  <!-- Pillar 2 -->
                  <div class="p-3 sm:p-3.5 rounded-xl bg-surface border border-border">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="w-4 h-4 rounded-full bg-primary text-white text-[10px] font-bold flex items-center justify-center">2</span>
                      <h4 class="text-xs sm:text-sm font-bold text-foreground">{t(locale, 'about.philosophy.card2.title')}</h4>
                    </div>
                    <p class="text-[11px] sm:text-xs text-muted leading-relaxed">
                      {t(locale, 'about.philosophy.card2.desc')}
                    </p>
                  </div>
                </div>

                <div class="relative z-10 border-t border-border pt-3 text-[11px] text-muted">
                  <span>{isRtl ? 'المعايير المنهجية' : 'Methodological Standards'}</span>
                </div>
              </div>
            </div>

            <!-- ==================== PAGE 6 (Right of Spread 3: Pillar 3 & Capabilities) ==================== -->
            <div class="pages_page page-6">
              <div
                class="pages_page__inner bg-surface text-foreground border-l border-border p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden transition-colors duration-300"
                dir={isRtl ? 'rtl' : 'ltr'}
              >
                <!-- Spine shadow overlay on left edge -->
                <div class="pointer-events-none absolute top-0 left-0 bottom-0 w-8 bg-gradient-to-r from-black/40 to-transparent opacity-30 dark:opacity-100 z-20" aria-hidden="true"></div>

                <div class="relative z-10 flex items-center justify-between border-b border-border pb-4">
                  <span class="text-xs font-semibold text-muted">
                    {isRtl ? 'المنظومة المتكاملة' : 'Integrated Capabilities'}
                  </span>
                  <div class="text-xs font-mono font-bold text-primary tracking-widest">06 / 08</div>
                </div>

                <div class="relative z-10 my-auto space-y-3.5 py-2">
                  <!-- Pillar 3 -->
                  <div class="p-3 sm:p-3.5 rounded-xl bg-surface-elevated border border-border">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="w-4 h-4 rounded-full bg-primary text-white text-[10px] font-bold flex items-center justify-center">3</span>
                      <h4 class="text-xs sm:text-sm font-bold text-primary">{t(locale, 'about.philosophy.card3.title')}</h4>
                    </div>
                    <p class="text-[11px] sm:text-xs text-muted leading-relaxed">
                      {t(locale, 'about.philosophy.card3.desc')}
                    </p>
                  </div>

                  <!-- 4 Capability Badges -->
                  <div class="grid grid-cols-2 gap-2 pt-1">
                    <div class="px-2 py-1.5 rounded-lg bg-primary/10 border border-primary/25 text-center">
                      <span class="text-[10px] font-semibold text-primary block">{isRtl ? 'بناء الهوية' : 'Branding'}</span>
                    </div>
                    <div class="px-2 py-1.5 rounded-lg bg-surface-elevated border border-border text-center">
                      <span class="text-[10px] font-semibold text-foreground block">{isRtl ? 'حملات تسويقية' : 'Campaigns'}</span>
                    </div>
                    <div class="px-2 py-1.5 rounded-lg bg-surface-elevated border border-border text-center">
                      <span class="text-[10px] font-semibold text-foreground block">{isRtl ? 'صناعة المحتوى' : 'Content Craft'}</span>
                    </div>
                    <div class="px-2 py-1.5 rounded-lg bg-primary/10 border border-primary/25 text-center">
                      <span class="text-[10px] font-semibold text-primary block">{isRtl ? 'حلول رقمية' : 'Digital Web'}</span>
                    </div>
                  </div>
                </div>

                <!-- Turn Next Control (Next - Flips inward to the left) -->
                <div class="control next" title={isRtl ? 'الصفحة التالية' : 'Next Page'}>
                  <label for="page-trigger-4">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                  </label>
                </div>

                <div class="relative z-10 border-t border-border pt-3 text-[11px] text-muted">
                  <span>{isRtl ? 'شراكة تحقق الأرقام' : 'Partnership for Results'}</span>
                </div>
              </div>
            </div>

            <!-- ==================== PAGE 7 (Left of Spread 4: Credentials & Metrics) ==================== -->
            <div class="pages_page page-7">
              <div
                class="pages_page__inner bg-surface-elevated text-foreground border-r border-border p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden transition-colors duration-300"
                dir={isRtl ? 'rtl' : 'ltr'}
              >
                <!-- Spine shadow overlay on right edge -->
                <div class="pointer-events-none absolute top-0 right-0 bottom-0 w-8 bg-gradient-to-l from-black/40 to-transparent opacity-30 dark:opacity-100 z-20" aria-hidden="true"></div>

                <div class="relative z-10 flex items-center justify-between border-b border-border pb-4">
                  <span class="text-xs font-bold text-primary tracking-wider uppercase">
                    {isRtl ? 'أثر بالأرقام' : 'Impact In Numbers'}
                  </span>
                  <div class="text-xs font-mono font-bold text-primary tracking-widest">07 / 08</div>
                </div>

                <!-- Turn Back Control (Prev - Flips back to the right) -->
                <div class="control prev" title={isRtl ? 'الصفحة السابقة' : 'Previous Page'}>
                  <label for="page-trigger-3">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </label>
                </div>

                <!-- Metrics -->
                <div class="relative z-10 my-auto space-y-2.5 py-2">
                  <div class="p-2.5 sm:p-3 rounded-xl bg-surface border border-border flex items-center justify-between">
                    <div>
                      <div class="text-lg sm:text-xl font-black text-primary font-heading">+18</div>
                      <div class="text-[11px] text-muted">{t(locale, 'about.hero.stat1.label')}</div>
                    </div>
                  </div>

                  <div class="p-2.5 sm:p-3 rounded-xl bg-surface border border-border flex items-center justify-between">
                    <div>
                      <div class="text-lg sm:text-xl font-black text-primary font-heading">100%</div>
                      <div class="text-[11px] text-muted">{t(locale, 'about.hero.stat2.label')}</div>
                    </div>
                  </div>

                  <div class="p-2.5 sm:p-3 rounded-xl bg-surface border border-border flex items-center justify-between">
                    <div>
                      <div class="text-lg sm:text-xl font-black text-primary font-heading">360°</div>
                      <div class="text-[11px] text-muted">{t(locale, 'about.hero.stat3.label')}</div>
                    </div>
                  </div>
                </div>

                <div class="relative z-10 border-t border-border pt-3 text-[11px] text-muted">
                  <span>{isRtl ? 'المصداقية وسجل النجاح' : 'Proven Track Record'}</span>
                </div>
              </div>
            </div>

            <!-- ==================== PAGE 8 (Right of Spread 4: Closing CTA Cover) ==================== -->
            <div class="pages_page page-8">
              <div
                class="pages_page__inner bg-surface text-foreground border-l border-border p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden transition-colors duration-300"
                dir={isRtl ? 'rtl' : 'ltr'}
              >
                <!-- Spine shadow overlay on left edge -->
                <div class="pointer-events-none absolute top-0 left-0 bottom-0 w-8 bg-gradient-to-r from-black/40 to-transparent opacity-30 dark:opacity-100 z-20" aria-hidden="true"></div>

                <div class="relative z-10 flex items-center justify-between border-b border-border pb-4">
                  <span class="text-xs font-semibold text-primary">
                    {isRtl ? 'الخطوة القادمة' : 'Next Step'}
                  </span>
                  <div class="text-xs font-mono font-bold text-primary tracking-widest">08 / 08</div>
                </div>

                <!-- Content and CTA -->
                <div class="relative z-10 my-auto py-2 text-center flex flex-col items-center">
                  
                  
                  <h3 class="text-base sm:text-lg lg:text-xl font-bold text-foreground mb-2 leading-snug">
                    <span>{t(locale, 'about.cta.headlinePart1')} </span>
                    <span class="text-primary">{t(locale, 'about.cta.headlineHighlight')}</span>
                  </h3>
                  
                  <p class="text-[11px] sm:text-xs text-muted leading-relaxed max-w-xs mb-5">
                    {t(locale, 'about.cta.description')}
                  </p>

                  <!-- Action Links -->
                  <div class="flex flex-col sm:flex-row gap-2 w-full max-w-xs justify-center">
                    <a
                      href={`/${locale}/contact/`}
                      class="px-4 py-2 rounded-full bg-primary text-white text-xs font-bold hover:bg-primary-dark hover:shadow-lg hover:shadow-primary/30 transition-all flex items-center justify-center"
                    >
                      {t(locale, 'about.cta.primaryBtn')}
                    </a>
                    <a
                      href={`/${locale}/work/`}
                      class="px-4 py-2 rounded-full bg-surface-elevated hover:bg-surface text-foreground border border-border shadow-sm transition-all text-center"
                    >
                      {t(locale, 'about.hero.cta.work')}
                    </a>
                  </div>
                </div>

                <div class="relative z-10 border-t border-border pt-3 flex items-center justify-between text-[11px] text-muted">
                  <span>{isRtl ? 'جميع الحقوق محفوظة' : 'All Rights Reserved'}</span>
