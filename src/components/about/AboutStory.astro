---
/**
 * AboutStory.astro
 *
 * Narrative & Founder Section for the About Page.
 * Displays:
 * 1. "نسرد قصتنـــا" — Narrative origin story starting from Onaizah (styled in Dimnah font for Arabic).
 * 2. "خلف ناروما.. رؤية تتخطى العادي" — Editorial quote & Founder profile card with portrait of Raghad Al-Mazyad.
 *
 * Fully responsive, accessible, theme-aware (light/dark), and compliant with Naroma Design System.
 */
import Container from '../ui/Container.astro';
import { t } from '../../lib/i18n/index.js';

interface Props {
  locale: 'ar' | 'en';
}

const { locale } = Astro.props;
const isRtl = locale === 'ar';
---

<section
  id="about-story"
  class="relative py-16 sm:py-20 md:py-28 overflow-hidden bg-background text-foreground transition-colors duration-300 border-t border-border/50"
  dir={isRtl ? 'rtl' : 'ltr'}
>
  <!-- Background Pattern Watermark -->
  <div
    class="pointer-events-none absolute inset-0 z-0 bg-repeat opacity-[0.025] dark:opacity-[0.04] bg-[url('/images/hero/bg-pattern.webp')] bg-[length:320px_430px]"
    aria-hidden="true"
  ></div>

  <!-- Ambient Brand Radial Accents -->
  <div
    class="pointer-events-none absolute top-12 start-0 -translate-x-1/3 z-0 w-[420px] h-[420px] rounded-full bg-[radial-gradient(circle,rgba(109,64,219,0.12)_0%,transparent_70%)] dark:bg-[radial-gradient(circle,rgba(109,64,219,0.18)_0%,transparent_70%)]"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute bottom-12 end-0 translate-x-1/3 z-0 w-[400px] h-[400px] rounded-full bg-[radial-gradient(circle,rgba(215,255,123,0.08)_0%,transparent_70%)] dark:bg-[radial-gradient(circle,rgba(215,255,123,0.06)_0%,transparent_70%)]"
    aria-hidden="true"
  ></div>

  <Container class="relative z-10">
    <!-- ============================================================
         CHAPTER 1: نسرد قصتنـــا (Our Story)
         ============================================================ -->
    <div class="max-w-4xl">
      <!-- Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs sm:text-sm font-semibold mb-5 border border-primary/20 backdrop-blur-sm">
        <svg class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z" />
        </svg>
        <span>{t(locale, 'about.story.badge')}</span>
      </div>

      <!-- Main Heading in Dimnah Font (Arabic) -->
      <h2
        class:list={[
          'text-2xl sm:text-3xl md:text-4xl text-foreground leading-[1.35] tracking-wide mb-8',
          isRtl ? 'font-dimnah' : 'font-heading font-extrabold',
        ]}
      >
        {t(locale, 'about.story.title')}
      </h2>

      <!-- Story Narrative Paragraphs -->
      <div class="space-y-6 text-base sm:text-lg md:text-xl text-muted dark:text-gray-300 leading-relaxed md:leading-loose">
        <p class="font-normal">
          <span>{t(locale, 'about.story.p1Part1')}</span>
          <span class="inline-block font-bold text-primary px-2 py-0.5 rounded-md bg-primary/10 border border-primary/20 mx-1">
            {t(locale, 'about.story.onaizah')}
          </span>
          <span>{t(locale, 'about.story.p1Part2')}</span>
        </p>
        <p class="font-normal">
          {t(locale, 'about.story.p2')}
        </p>
      </div>
    </div>

    <!-- Editorial Divider Between Narrative and Leadership -->
    <div class="my-14 sm:my-20 md:my-24 flex items-center justify-center gap-4 text-border" aria-hidden="true">
      <div class="h-[1px] flex-1 max-w-sm bg-gradient-to-r from-transparent via-border to-border/80"></div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
      </div>
      <div class="h-[1px] flex-1 max-w-sm bg-gradient-to-l from-transparent via-border to-border/80"></div>
    </div>

    <!-- ============================================================
         CHAPTER 2: خلف ناروما.. رؤية تتخطى العادي & Founder Card
         ============================================================ -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <!-- Vision & Statement Column -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs sm:text-sm font-semibold mb-4 border border-primary/20 w-fit backdrop-blur-sm">
          <svg class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z" />
          </svg>
          <span>{t(locale, 'about.founder.badge')}</span>
        </div>

        <!-- Heading -->
        <h3 class="text-xl sm:text-2xl md:text-3xl font-bold text-foreground leading-[1.3] tracking-tight mb-6">
          <span>{t(locale, 'about.founder.titlePart1')}</span>
          <span class="text-primary">{t(locale, 'about.founder.titleHighlight')}</span>
        </h3>

        <!-- Vision Quote Block -->
        <blockquote class="relative border-s-2 border-primary ps-5 sm:ps-6 py-3 my-2 bg-surface/60 dark:bg-surface/30 rounded-e-xl p-5 border border-border/40">
          <p class="text-base sm:text-lg md:text-xl text-foreground/95 font-medium leading-relaxed">
            "{t(locale, 'about.founder.quote')}"
          </p>
        </blockquote>

        <!-- Strategic Principles Pills -->
        <div class="mt-8 flex flex-wrap gap-2.5">
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs sm:text-sm bg-surface-elevated border border-border text-foreground/80 font-medium shadow-xs">
            {isRtl ? 'فهم عميق للمشروع' : 'Deep Brand Discovery'}
          </span>
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs sm:text-sm bg-surface-elevated border border-border text-foreground/80 font-medium shadow-xs">
            {isRtl ? 'استراتيجيات مدروسة' : 'Deliberate Strategy'}
          </span>
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs sm:text-sm bg-surface-elevated border border-border text-foreground/80 font-medium shadow-xs">
            {isRtl ? 'إبداع يصنع الفرق' : 'Impactful Creativity'}
          </span>
        </div>
      </div>

      <!-- Founder Portrait Card Column -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <figure class="w-full max-w-[300px] sm:max-w-[340px] bg-surface-elevated border border-primary rounded-2xl p-4 sm:p-5 shadow-card hover:shadow-card-hover transition-all duration-300">
          <!-- Portrait Container -->
          <div class="relative overflow-hidden rounded-xl aspect-[3/4] bg-surface">
            <img
              src="/images/about/raghad-al-mazyad.webp"
              alt={`${t(locale, 'about.founder.name')} — ${t(locale, 'about.founder.role')}`}
              width="480"
              height="640"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover object-top filter grayscale contrast-105 hover:grayscale-0 transition-all duration-700"
            />
            <div
              class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-30"
              aria-hidden="true"
            ></div>
          </div>

          <!-- Small Name & Title under the photo per user request -->
          <figcaption class="pt-4 pb-1 text-center">
            <div class="w-8 h-[2px] bg-primary mx-auto mb-2.5 rounded-full" aria-hidden="true"></div>
            <div class="text-xs sm:text-sm font-bold text-foreground tracking-wide">
              {t(locale, 'about.founder.name')}
            </div>
            <div class="text-[11px] sm:text-xs text-muted font-medium mt-0.5">
              {t(locale, 'about.founder.role')}
            </div>
          </figcaption>
        </figure>
      </div>
    </div>
  </Container>
</section>

