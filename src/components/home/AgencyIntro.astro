---
/**
 * AgencyIntro.astro
 *
 * Strategic Agency Introduction / About Preview Section for Nroma Home Page.
 * Showcases the agency's core philosophy, client-approved copy, strategic pillars,
 * and the official 3D branding tennis racket (Sleek_Purple_Nroma_Tennis_Racket.webp).
 * Fully responsive, accessible, theme-compatible (light/dark), and SEO optimized.
 *
 * Performance: All ambient glows use pre-rendered radial-gradient (zero CSS filter cost).
 * Scroll-reveal uses lightweight GPU-composited translate3d + opacity only.
 */
import Container from '../ui/Container.astro';
import { getLocaleFromUrl, localePath, t } from '../../lib/i18n/index.js';

const locale = getLocaleFromUrl(Astro.url);

const pillars = [
  {
    number: '01',
    title: t(locale, 'home.intro.pillar1.title'),
    desc: t(locale, 'home.intro.pillar1.desc'),
  },
  {
    number: '02',
    title: t(locale, 'home.intro.pillar2.title'),
    desc: t(locale, 'home.intro.pillar2.desc'),
  },
  {
    number: '03',
    title: t(locale, 'home.intro.pillar3.title'),
    desc: t(locale, 'home.intro.pillar3.desc'),
  },
];
---

<section
  id="about-intro"
  class="intro-section relative py-24 sm:py-32 bg-background text-foreground overflow-hidden"
  aria-labelledby="intro-heading"
>
  <Container>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-10 sm:gap-12 lg:gap-20 xl:gap-28">
      
      <!-- 3D Tennis Racket Showcase (Desktop & Tablet) -->
      <div class="hidden sm:flex flex-shrink-0 w-full sm:w-[42%] md:w-[45%] lg:w-[46%] max-w-[420px] md:max-w-[480px] lg:max-w-[540px] xl:max-w-[580px] relative flex-col items-center justify-center fade-in-up">
        <!-- Ambient Glow Aura behind Racket (pre-rendered radial-gradient, zero blur filter cost) -->
        <div
          class="intro-glow pointer-events-none absolute w-64 sm:w-80 lg:w-96 h-48 sm:h-60 lg:h-72 rounded-full transform-gpu -z-10"
          aria-hidden="true"
        ></div>
        
        <!-- 3D Racket Target Container -->
        <div
          class="racket-target relative w-full flex flex-col items-center justify-center py-2 select-none"
          data-racket-target
        >
          <img
            src="/images/Sleek_Purple_Nroma_Tennis_Racket.webp"
            alt={t(locale, 'home.intro.racketAlt')}
            width="612"
            height="408"
            class="racket-image w-full h-auto object-contain select-none pointer-events-none transform-gpu"
            loading="eager"
            decoding="async"
          />

          <!-- Invisible precise string-bed anchor target for geometry calculation -->
          <span
            data-string-bed
            class="racket-string-bed pointer-events-none absolute"
            style="left: 70.3%; top: 37.5%; width: 2px; height: 2px; opacity: 0;"
            aria-hidden="true"
          ></span>

          <!-- Subtle glowing string-bed impact ripple ring (pure CSS transform/opacity, 0 layout shifts) -->
          <span
            data-racket-impact-ring
            class="racket-impact-ring pointer-events-none absolute rounded-full border border-primary/80 bg-primary/25"
            style="left: 70.3%; top: 37.5%; width: 64px; height: 64px; margin-left: -32px; margin-top: -32px; transform: scale(0); opacity: 0;"
            aria-hidden="true"
          ></span>
        </div>
      </div>
      
      <!-- Narrative & Strategy Content Column -->
      <div class="flex-1 w-full flex flex-col justify-center">
        <!-- Section Title (Client Approved Copy) -->
        <h2
          id="intro-heading"
          class="fade-in-up text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-foreground leading-[1.5] max-w-2xl mb-4 sm:mb-5"
        >
          {t(locale, 'home.intro.headline')}
        </h2>

        <!-- Accent Divider Line -->
        <div class="fade-in-up flex items-center mb-4 sm:mb-5">
          <span class="w-8 sm:w-12 h-[2px] bg-primary" aria-hidden="true"></span>
        </div>

        <!-- Tagline Statement -->
        <p class="fade-in-up text-sm md:text-base font-medium text-primary-light dark:text-primary-light leading-relaxed mb-6">
          {t(locale, 'home.intro.tagline')}
        </p>

        <!-- Mobile-Only Racket Visual (Placed smoothly in mobile flow between tagline and narrative) -->
        <div class="sm:hidden w-full flex flex-col items-center justify-center my-6 py-2">
          <div
            class="racket-target relative w-full max-w-[280px] sm:max-w-[320px] flex flex-col items-center justify-center select-none"
            data-racket-target
          >
            <!-- Ambient Glow for Mobile (pre-rendered radial-gradient, zero blur filter cost) -->
            <div
              class="intro-glow-mobile pointer-events-none absolute w-52 h-36 rounded-full transform-gpu -z-10"
              aria-hidden="true"
            ></div>
            
            <img
              src="/images/Sleek_Purple_Nroma_Tennis_Racket.webp"
              alt={t(locale, 'home.intro.racketAlt')}
              width="612"
              height="408"
              class="racket-image w-full h-auto object-contain select-none pointer-events-none transform-gpu"
              loading="eager"
              decoding="async"
            />

            <!-- Mobile string-bed anchor target -->
            <span
              data-string-bed
              class="racket-string-bed pointer-events-none absolute"
              style="left: 70.3%; top: 37.5%; width: 2px; height: 2px; opacity: 0;"
              aria-hidden="true"
            ></span>

            <!-- Mobile impact ripple ring -->
            <span
              data-racket-impact-ring
              class="racket-impact-ring pointer-events-none absolute rounded-full border border-primary/80 bg-primary/25"
              style="left: 70.3%; top: 37.5%; width: 48px; height: 48px; margin-left: -24px; margin-top: -24px; transform: scale(0); opacity: 0;"
              aria-hidden="true"
            ></span>
          </div>
        </div>

        <!-- Highlighted Narrative Heading ("نعيد تعريف العادي") -->
        <h3 class="fade-in-up text-2xl sm:text-3xl md:text-3xl font-bold text-foreground tracking-tight leading-snug mb-4 sm:mb-6 flex flex-wrap items-center gap-x-2.5 gap-y-1">
          <span>{t(locale, 'home.intro.redefinePrefix')}</span>
          <span class="inline-flex items-center justify-center bg-primary px-2.5 sm:px-3 py-0.5 sm:py-1 rounded-[3px] leading-none select-none">
            {t(locale, 'home.intro.redefineHighlight')}
          </span>
        </h3>

        <!-- Body Paragraphs (Client Narrative) -->
        <div class="fade-in-up space-y-4 text-sm md:text-base text-muted leading-relaxed mb-8">
          <p>
            {t(locale, 'home.intro.p1')}
          </p>
          <p>
            {t(locale, 'home.intro.p2')}
          </p>
        </div>

        <!-- 3 Core Strategic Pillars Cards -->
        <div class="fade-in-up grid grid-cols-1 lg:grid-cols-3 gap-4 mb-10">
          {pillars.map((pillar) => (
            <div class="intro-pillar-card p-4 sm:p-5 rounded-2xl border border-border/80 bg-surface/60">
              <span class="text-sm font-bold text-primary-light tracking-widest block mb-2">
                {pillar.number}
              </span>
              <h3 class="text-sm font-bold text-foreground mb-1">
                {pillar.title}
              </h3>
              <p class="text-sm text-muted leading-normal">
                {pillar.desc}
              </p>
            </div>
          ))}
        </div>

        <!-- Interactive CTA Link -->
        <div class="fade-in-up flex items-center gap-4">
          <a
            href={localePath(locale, 'about')}
            class="button-primary group inline-flex items-center gap-3"
          >
            <span>{t(locale, 'home.intro.cta')}</span>
            <svg
              class="w-4 h-4 rtl:rotate-180 transition-transform duration-300 group-hover:translate-x-1 rtl:group-hover:-translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>

      </div>

    </div>
  </Container>
</section>

<style>
  /* Section-level isolation — prevents paint from bleeding into adjacent sections */
  .intro-section {
    contain: layout paint;
  }

  /* Ambient glow: pre-rendered radial-gradient replaces expensive blur-3xl CSS filter */
  .intro-glow {
    background: radial-gradient(
      ellipse at center,
      rgba(109, 64, 219, 0.18) 0%,
      rgba(109, 64, 219, 0.08) 40%,
      transparent 70%
    );
  }

  /* Mobile ambient glow: pre-rendered radial-gradient replaces blur-2xl */
  .intro-glow-mobile {
    background: radial-gradient(
      ellipse at center,
      rgba(109, 64, 219, 0.16) 0%,
      rgba(109, 64, 219, 0.06) 45%,
      transparent 75%
    );
  }

  .racket-image {
    contain: layout paint;
    backface-visibility: hidden;
    /* will-change removed — set dynamically by TennisBallScrollAnimation only when animating */
  }

  .racket-impact-ring {
    pointer-events: none;
    /* box-shadow instead of filter: drop-shadow for lighter GPU cost */
    box-shadow: 0 0 12px rgba(109, 64, 219, 0.5);
  }

  /* Pillar cards: transition only specific GPU-friendly properties instead of transition-all */
  .intro-pillar-card {
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    transition:
      transform 300ms ease-out,
      border-color 300ms ease-out,
      box-shadow 300ms ease-out,
      background-color 300ms ease-out;
  }

  .intro-pillar-card:hover {
    transform: translate3d(0, -6px, 0);
    border-color: rgba(109, 64, 219, 0.4);
    background-color: var(--color-surface);
    box-shadow:
      0 10px 25px -5px rgba(0, 0, 0, 0.1),
      0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .racket-image {
      transform: none !important;
    }
    .racket-impact-ring {
      display: none !important;
    }
    .intro-pillar-card {
      transition: none !important;
    }
  }
</style>
